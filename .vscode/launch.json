{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        },
        {
            "name": "GalaxyFastAPI uvicorn",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "--app-dir",
                "lib",
                "--factory",
                "galaxy.webapps.galaxy.fast_factory:factory"
            ],
            "env": {
                "GALAXY_CONFIG_FILE": "${workspaceFolder}/config/galaxy.yml"
            },
            "python": "${workspaceFolder}/.venv/bin/python3",
            "justMyCode": false,
            // "console": "integratedTerminal",
            "autoReload": {
                "enable": true
            },
            "windows": {
                "python": "${workspaceFolder}/.venv/bin/python3.exe"
            }
        },
        {
            "name": "Python Debugger: Remote Attach Wetlands",
            "type": "debugpy",
            "request": "attach",
            "justMyCode": false,
            "connect": {
                "host": "localhost",
                "port": 57869
            },
            "pathMappings": [
                {
                    "localRoot": "/Users/amasson/Travail/wetlands/src/wetlands/_internal",
                    "remoteRoot": "/Users/amasson/Travail/wetlands/src/wetlands/_internal"
                }
            ]
        }
    ]
}