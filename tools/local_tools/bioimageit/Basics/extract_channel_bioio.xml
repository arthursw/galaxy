<?xml version="1.0" ?>
<tool id="extract_channel_bioio" name="Extract channel" version="0.1.0+galaxy0" python_template_version="3.5" profile="21.05">
    <command detect_errors="exit_code">python '$__tool_directory__/extract_channel_bioio_galaxy_wrapper.py' '${input_image}' --channel '${channel}' '${output_image}'</command>
    <inputs>
        <param name="input_image" argument="--input_image" type="data" format="png,tiff,tif" label="Input image" help="Input image" optional="false"/>
        <param name="channel" argument="--channel" type="integer" value="0" label="Channel to extract" help="Channel to extract"/>
    </inputs>
    <outputs>
        <data name="output_image" format="tiff"/>
    </outputs>
    <help>

Extract an image channel.

</help>
</tool>
