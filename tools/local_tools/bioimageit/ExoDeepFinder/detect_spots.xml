<?xml version="1.0" ?>
<tool id="detect_spots" name="Detect spots" version="0.1.0+galaxy0" python_template_version="3.5" profile="21.05">
    <requirements>
        <requirement type="package">bioimageit::atlas</requirement>
        <requirement type="package">scikit-learn==1.3.2</requirement>
        <requirement type="package">scikit-image==0.22.0</requirement>
        <requirement type="package">h5py==3.11.0</requirement>
        <requirement type="package">mrcfile==1.4.3</requirement>
        <requirement type="package">matplotlib==3.8.1</requirement>
        <requirement type="package">pillow==10.3.0</requirement>
        <requirement type="package">python 3.10.14</requirement>
    </requirements>
    <command detect_errors="exit_code">python '$__tool_directory__/detect_spots_galaxy_wrapper.py' '${movie_folder}' '${tiff}' --atlas_args '${atlas_args}' '${output}'</command>
    <inputs>
        <param name="movie_folder" argument="--movie_folder" type="data" format="png,tiff,tif" label="Input folder containing the movie files (a least a tiff folder containing the movie frames)." help="Input folder containing the movie files (a least a tiff folder containing the movie frames)." optional="false"/>
        <param name="tiff" argument="--tiff" type="data" format="png,tiff,tif" value="tiff/" label="Path to the folder containing the tiff frames, relative to --movie_folder." help="Path to the folder containing the tiff frames, relative to --movie_folder."/>
        <param name="atlas_args" argument="--atlas_args" type="text" value="-rad 21 -pval 0.001 -arealim 3" label="Additional atlas arguments." help="Additional atlas arguments."/>
    </inputs>
    <outputs>
        <data name="output" format="txt"/>
    </outputs>
    <help>

Generate annotations from a segmentation.

</help>
</tool>
