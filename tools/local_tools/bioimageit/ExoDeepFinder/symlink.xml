<?xml version="1.0" ?>
<tool id="symlink" name="Symlink" version="0.1.0+galaxy0" python_template_version="3.5" profile="21.05">
    <command detect_errors="exit_code">python '$__tool_directory__/symlink_galaxy_wrapper.py' '${input_movie_folder}' '${movie}' '${output_movie_folder}' '${output_movie}'</command>
    <inputs>
        <param name="input_movie_folder" argument="--input_movie_folder" type="data" format="png,tiff,tif" label="Path to the input movie folder." help="Path to the input movie folder."/>
        <param name="movie" argument="--movie" type="data" format="png,tiff,tif" value="movie.h5" label="Input movie." help="Input movie."/>
    </inputs>
    <outputs>
        <data name="output_movie_folder" format="txt"/>
        <data name="output_movie" format="txt"/>
    </outputs>
    <help>

Symlink files to the workflow folder.

</help>
</tool>
