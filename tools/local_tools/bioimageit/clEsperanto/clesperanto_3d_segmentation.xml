<?xml version="1.0" ?>
<tool id="clesperanto_3d_segmentation" name="clEsperanto Segmentation" version="0.1.0+galaxy0" python_template_version="3.5" profile="21.05">
    <requirements>
        <requirement type="package">pyopencl</requirement>
        <requirement type="package">pyclesperanto-prototype</requirement>
    </requirements>
    <command detect_errors="exit_code">python '$__tool_directory__/clEsperanto_3d_segmentation_galaxy_wrapper.py' '${input_image}' --sigma_spot_detection '${sigma_spot_detection}' --sigma_outline '${sigma_outline}' --voxel_size_x '${voxel_size_x}' --voxel_size_y '${voxel_size_y}' --voxel_size_z '${voxel_size_z}' --radius_x '${radius_x}' --radius_y '${radius_y}' --radius_z '${radius_z}' '${out}'</command>
    <inputs>
        <param name="input_image" argument="--input_image" type="data" format="png,tiff,tif" label="Input image path" help="Input image path"/>
        <param name="sigma_spot_detection" argument="--sigma_spot_detection" type="float" label="sigma_spot_detection" help="sigma_spot_detection"/>
        <param name="sigma_outline" argument="--sigma_outline" type="float" label="sigma_outline" help="sigma_outline"/>
        <param name="voxel_size_x" argument="--voxel_size_x" type="float" label="voxel_size_x" help="voxel_size_x"/>
        <param name="voxel_size_y" argument="--voxel_size_y" type="float" label="voxel_size_y" help="voxel_size_y"/>
        <param name="voxel_size_z" argument="--voxel_size_z" type="float" label="voxel_size_z" help="voxel_size_z"/>
        <param name="radius_x" argument="--radius_x" type="float" label="radius_x" help="radius_x"/>
        <param name="radius_y" argument="--radius_y" type="float" label="radius_y" help="radius_y"/>
        <param name="radius_z" argument="--radius_z" type="float" label="radius_z" help="radius_z"/>
    </inputs>
    <outputs>
        <data name="out" format="txt"/>
    </outputs>
    <tests>
        <test>
            <param name="input_image" value="test-data/IXMtest_A02_s9.tif"/>
            <param name="out" value="test-data/IXMtest_A02_s9_mask.tif"/>
            <assert_contents file="out"/>
        </test>
    </tests>
    <help>

Segment with clEsperanto.

</help>
</tool>
