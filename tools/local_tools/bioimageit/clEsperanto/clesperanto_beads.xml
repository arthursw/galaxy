<?xml version="1.0" ?>
<tool id="clesperanto_beads" name="clEsperanto Beads" version="0.1.0+galaxy0" python_template_version="3.5" profile="21.05">
    <requirements>
        <requirement type="package">pyopencl</requirement>
        <requirement type="package">pyclesperanto-prototype</requirement>
    </requirements>
    <command detect_errors="exit_code">python '$__tool_directory__/clEsperanto_beads_galaxy_wrapper.py' '${input_image}' --scalar '${scalar}' '${out}'</command>
    <inputs>
        <param name="input_image" argument="--input_image" type="data" format="png,tiff,tif" label="Input image path" help="Input image path"/>
        <param name="scalar" argument="--scalar" type="float" value="0.5" label="scalar for thresholds" help="scalar for thresholds"/>
    </inputs>
    <outputs>
        <data name="out" format="csv"/>
    </outputs>
    <tests>
        <test>
            <param name="input_image" value="test-data/beads.tif"/>
            <param name="out" value="test-data/beads_info.csv"/>
            <assert_contents file="out"/>
        </test>
    </tests>
    <help>

Beads with clEsperanto.

</help>
</tool>
