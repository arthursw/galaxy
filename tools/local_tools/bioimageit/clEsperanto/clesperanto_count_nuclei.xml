<?xml version="1.0" ?>
<tool id="clesperanto_count_nuclei" name="clEsperanto count with channels" version="0.1.0+galaxy0" python_template_version="3.5" profile="21.05">
    <command detect_errors="exit_code">python '$__tool_directory__/clEsperanto_count_nuclei_galaxy_wrapper.py' '${input_image}' --spot_sigma '${spot_sigma}' '${out}'</command>
    <inputs>
        <param name="input_image" argument="--input_image" type="data" format="png,tiff,tif" label="Input image path" help="Input image path"/>
        <param name="spot_sigma" argument="--spot_sigma" type="text" value="20" label="Spot sigma" help="Spot sigma"/>
    </inputs>
    <outputs>
        <data name="out" format="csv"/>
    </outputs>
    <tests>
        <test>
            <param name="input_image" value="test-data/test.png"/>
            <param name="out" value="test-data/test_nuclei_count.csv"/>
            <assert_contents file="out"/>
        </test>
    </tests>
    <help>

Count particles with channels in clEsperanto.

</help>
</tool>
