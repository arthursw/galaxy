<?xml version="1.0" ?>
<tool id="omero_download" name="Omero Download" version="0.1.0+galaxy0" python_template_version="3.5" profile="21.05">
    <command detect_errors="exit_code">python '$__tool_directory__/omero_download_galaxy_wrapper.py' --dataset_id '${dataset_id}' '${out}'</command>
    <inputs>
        <param name="dataset_id" argument="--dataset_id" type="integer" label="Dataset ID" help="Dataset ID"/>
    </inputs>
    <outputs>
        <data name="out" format="txt"/>
    </outputs>
    <help>

Download files from Omero.

</help>
</tool>
