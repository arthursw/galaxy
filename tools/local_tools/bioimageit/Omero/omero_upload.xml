<?xml version="1.0" ?>
<tool id="omero_upload" name="Omero Upload" version="0.1.0+galaxy0" python_template_version="3.5" profile="21.05">
    <requirements>
        <requirement type="package">omero-py==5.15.0</requirement>
    </requirements>
    <command detect_errors="exit_code">python '$__tool_directory__/omero_upload_galaxy_wrapper.py' '${image}' --metadata_columns '${metadata_columns}' --dataset_id '${dataset_id}'</command>
    <inputs>
        <param name="image" argument="--image" type="data" format="png,tiff,tif" label="Image to upload" help="Image to upload" optional="false"/>
        <param name="metadata_columns" argument="--metadata_columns" type="text" label="Metadata columns (for example [&quot;column 1&quot;, &quot;column 2&quot;])" help="Metadata columns (for example [&quot;column 1&quot;, &quot;column 2&quot;])"/>
        <param name="dataset_id" argument="--dataset_id" type="integer" label="Dataset ID (ignored if negative)" help="Dataset ID (ignored if negative)" optional="false"/>
    </inputs>
    <help>

Upload data to an Omero database.

</help>
</tool>
