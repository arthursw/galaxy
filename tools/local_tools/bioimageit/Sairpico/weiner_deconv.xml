<?xml version="1.0" ?>
<tool id="weiner_deconv" name="Wiener Deconv" version="0.1.0+galaxy0" python_template_version="3.5" profile="21.05">
    <requirements>
        <requirement type="package">sylvainprigent::simglib=0.1.2|osx-64,win-64,linux-64</requirement>
        <requirement type="package">python 3.9</requirement>
    </requirements>
    <command detect_errors="exit_code">python '$__tool_directory__/Weiner_Deconv_galaxy_wrapper.py' '${input}' --type '${type}' --sigma '${sigma}' '${psf}' --lambda '${lambda}' --padding ${padding} '${output}'</command>
    <inputs>
        <param name="input" argument="--input" type="data" format="png,tiff,tif" label="Input Image" help="Input Image" optional="false"/>
        <param name="type" argument="--type" type="text" value="2D" label="Perform 2D, 2D Slice or 3D deconvolution." help="Perform 2D, 2D Slice or 3D deconvolution.">
            <option value="2D" selected="true">2D</option>
            <option value="2D Slice">2D Slice</option>
            <option value="3D">3D</option>
        </param>
        <param name="sigma" argument="--sigma" type="float" value="1.5" label="Gaussian PSF width (for 2D and 2D Slice only)" help="Gaussian PSF width (for 2D and 2D Slice only)"/>
        <param name="psf" argument="--psf" type="data" format="png,tiff,tif" label="PSF Image (for 3D only)" help="PSF Image (for 3D only)"/>
        <param name="lambda" argument="--lambda" type="float" value="0.01" label="Regularization parameter" help="Regularization parameter"/>
        <param name="padding" argument="--padding" type="boolean" checked="false" label="Add padding to process border pixels" help="Add padding to process border pixels"/>
    </inputs>
    <outputs>
        <data name="output" format="txt"/>
    </outputs>
    <help>

Wiener deconvolution

</help>
</tool>
