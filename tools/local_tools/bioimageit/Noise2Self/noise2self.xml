<?xml version="1.0" ?>
<tool id="noise2self" name="Noise2Self" version="0.1.0+galaxy0" python_template_version="3.5" profile="21.05">
    <requirements>
        <requirement type="package">pytorch::pytorch</requirement>
        <requirement type="package">pytorch::torchvision</requirement>
        <requirement type="package">matplotlib</requirement>
        <requirement type="package">noise2self</requirement>
    </requirements>
    <command detect_errors="exit_code">python '$__tool_directory__/noise2self_galaxy_wrapper.py' '${input_image}' --model_name '${model_name}' --num_of_layers '${num_of_layers}' --masker_width '${masker_width}' --iterations '${iterations}' '${out}'</command>
    <inputs>
        <param name="input_image" argument="--input_image" type="data" format="png,tiff,tif" label="The input image path." help="The input image path." optional="false"/>
        <param name="model_name" argument="--model_name" type="text" value="Unet" label="The model to use." help="The model to use.">
            <option value="BabyUnet">BabyUnet</option>
            <option value="DnCNN">DnCNN</option>
            <option value="SingleConvolution">SingleConvolution</option>
            <option value="Unet" selected="true">Unet</option>
        </param>
        <param name="num_of_layers" argument="--num_of_layers" type="integer" label="Number of layers in the convolutional network" help="Number of layers in the convolutional network"/>
        <param name="masker_width" argument="--masker_width" type="integer" label="Width of the mask" help="Width of the mask"/>
        <param name="iterations" argument="--iterations" type="integer" label="Number of iterations during training" help="Number of iterations during training"/>
    </inputs>
    <outputs>
        <data name="out" format="txt"/>
    </outputs>
    <help>

Noise2Self - Learning Denoising from Single Noisy Images.

</help>
</tool>
