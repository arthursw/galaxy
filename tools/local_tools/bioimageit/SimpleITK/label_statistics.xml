<?xml version="1.0" ?>
<tool id="label_statistics" name="Label statistics" version="0.1.0+galaxy0" python_template_version="3.5" profile="21.05">
    <command detect_errors="exit_code">python '$__tool_directory__/label_statistics_galaxy_wrapper.py' '${image}' '${label}' --minSize '${minSize}' --maxSize '${maxSize}' '${connected_component}'</command>
    <inputs>
        <param name="image" argument="--image" type="data" format="png,tiff,tif" label="Input image" help="Input image" optional="false"/>
        <param name="label" argument="--label" type="data" format="png,tiff,tif" label="Input label" help="Input label" optional="false"/>
        <param name="minSize" argument="--minSize" type="integer" value="100" label="Min size of the labels" help="Min size of the labels"/>
        <param name="maxSize" argument="--maxSize" type="integer" value="600" label="Max size of the labels" help="Max size of the labels"/>
    </inputs>
    <outputs>
        <data name="connected_component" format="txt"/>
    </outputs>
    <help>

Compute label statistics from a label image.

</help>
</tool>
